# Universal EditorConfig across all IDEs (VS Code, Cursor, Antigravity, IntelliJ, Eclipse)
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

[*.java]
indent_size = 4
max_line_length = 120

[*.{kt,kts}]
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
