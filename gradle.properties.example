# Gradle Properties Template for Local Development
# Copy or append this file to ~/.gradle/gradle.properties or local gradle.properties

# Set custom JDK 21 installation path (optional if JAVA_HOME is already exported in system shell)
# Examples:
# Linux (Ubuntu/Debian): org.gradle.java.home=/usr/lib/jvm/java-21-openjdk-amd64
# macOS (Apple Silicon): org.gradle.java.home=/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home
# Windows: org.gradle.java.home=C:\\Program Files\\Eclipse Adoptium\\jdk-21.0.6.7-hotspot

# Gradle JVM memory options
org.gradle.jvmargs=-Xmx2048m -XX:+UseG1GC -Dfile.encoding=UTF-8
