{
  "java.settings.url": ".vscode/org.eclipse.jdt.core.prefs",
  "java.configuration.runtimes": [
    {
      "name": "JavaSE-21",
      "path": "/home/kholifan/.jdks/temurin-21",
      "default": true
    }
  ],
  "java.autobuild.enabled": true,
  "java.debug.settings.hotCodeReplace": "never",
  "java.debug.settings.console": "internalConsole",
  "java.compile.nullAnalysis.mode": "disabled",
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/*/**": true,
    "**/target/**": true,
    "**/build/**": true,
    "**/bin/**": true,
    "**/.gradle/**": true,
    "**/.settings/**": true
  },
  "editor.formatOnSave": true,
  "editor.formatOnPaste": false,
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "[java]": {
    "editor.defaultFormatter": "redhat.java",
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "java.format.enabled": true,
  "java.format.settings.url": ".vscode/eclipse-java-formatter.xml",
  "java.format.settings.profile": "PromsJavaFormat",
  "java.format.comments.enabled": true,
  "java.format.onType.enabled": false,
  "java.saveActions.organizeImports": true,
  "java.sources.organizeImports.starThreshold": 99,
  "java.sources.organizeImports.staticStarThreshold": 99,
  "java.completion.importOrder": ["#", ""],
  "java.codeGeneration.toString.codeStyle": "STRING_BUILDER",
  "java.codeGeneration.hashCodeEquals.useJava7Objects": true,
  "java.codeGeneration.useBlocks": true,
  "java.configuration.updateBuildConfiguration": "interactive"
}
