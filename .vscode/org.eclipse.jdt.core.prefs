eclipse.preferences.version=1

# ------------------------------------------------------------------------------
# Eclipse JDT / Red Hat Java Formatter Configuration (120 chars, 4 spaces)
# Aligned with Enterprise Single-Indent (4 spaces) Continuation & Spotless
# ------------------------------------------------------------------------------
org.eclipse.jdt.core.formatter.lineSplit=120
org.eclipse.jdt.core.formatter.comment.line_length=120
org.eclipse.jdt.core.formatter.tabulation.char=space
org.eclipse.jdt.core.formatter.tabulation.size=4
org.eclipse.jdt.core.formatter.indentation.size=4
org.eclipse.jdt.core.formatter.continuation_indentation=1
org.eclipse.jdt.core.formatter.continuation_indentation_for_array_initializer=1
org.eclipse.jdt.core.formatter.join_wrapped_lines=false
org.eclipse.jdt.core.formatter.join_lines_in_comments=false
org.eclipse.jdt.core.formatter.use_on_off_tags=true
org.eclipse.jdt.core.formatter.disabling_tag=@formatter:off
org.eclipse.jdt.core.formatter.enabling_tag=@formatter:on

# Method invocation & Fluent APIs
org.eclipse.jdt.core.formatter.alignment_for_selector_in_method_invocation=80
org.eclipse.jdt.core.formatter.alignment_for_arguments_in_method_invocation=16
org.eclipse.jdt.core.formatter.alignment_for_arguments_in_allocation_expression=16
org.eclipse.jdt.core.formatter.alignment_for_arguments_in_explicit_constructor_call=16

# Annotations (52 = WRAP_ONE_PER_LINE + INDENT_BY_ONE = +4 spaces)
org.eclipse.jdt.core.formatter.alignment_for_arguments_in_annotation=52
org.eclipse.jdt.core.formatter.alignment_for_annotations_on_parameter=48
org.eclipse.jdt.core.formatter.insert_new_line_after_annotation_on_parameter=insert

# ------------------------------------------------------------------------------
# Eclipse JDT / Red Hat Java Compiler Diagnostics Configuration
# ------------------------------------------------------------------------------

# 1. Type safety: The expression of type Specification needs unchecked conversion
#    Problem: UnsafeTypeConversion / Java(16777748)
org.eclipse.jdt.core.compiler.problem.uncheckedTypeOperation=ignore
org.eclipse.jdt.core.compiler.problem.rawTypeReference=ignore

# 2. Null type safety: Reference expression parameter nullity unchecked
#    Problem: ReferenceExpressionParameterNullityUnchecked / Java(67109822)
org.eclipse.jdt.core.compiler.problem.nullUncheckedConversion=ignore
org.eclipse.jdt.core.compiler.problem.nullReference=ignore
org.eclipse.jdt.core.compiler.problem.potentialNullReference=ignore
org.eclipse.jdt.core.compiler.problem.nullSpecViolation=ignore
org.eclipse.jdt.core.compiler.problem.nullAnnotationInferenceConflict=ignore

# 3. Deprecated usage: Using deprecated types, methods, fields
#    Problem: UsingDeprecatedField / Java(33555840)
org.eclipse.jdt.core.compiler.problem.deprecation=ignore
org.eclipse.jdt.core.compiler.problem.terminalDeprecation=ignore
org.eclipse.jdt.core.compiler.problem.deprecationInDeprecatedCode=ignore
org.eclipse.jdt.core.compiler.problem.deprecationWhenOverridingDeprecatedMethod=ignore
