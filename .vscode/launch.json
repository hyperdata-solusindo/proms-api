{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Spring Boot - Launch",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "mainClass": "com.hyperdata.proms.ApiApplication",
      "projectName": "proms-api",
      "javaExec": "/home/kholifan/.sdkman/candidates/java/25-tem/bin/java",
