# syntax=docker/dockerfile:1

# ==============================================================================
# Single-Stage Minimal & Hardened JRE 21 Runtime for Pre-built Fast Deployments
# (Layers are built & extracted by Maven / GitHub Actions runner beforehand)
# ==============================================================================
FROM eclipse-temurin:21-jre-alpine

WORKDIR /app

# Install curl for container health check and tzdata for timezone configuration
RUN apk add --no-cache curl tzdata

# Create dedicated non-root system user and group
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

# Copy pre-extracted layers in order of change frequency (least to most frequent)
# 1. External dependencies (~90MB, rarely changes -> stays cached in GHCR / Server)
COPY --chown=appuser:appgroup target/extracted/dependencies/ /app/
# 2. Spring Boot loader (~600KB, rarely changes)
COPY --chown=appuser:appgroup target/extracted/spring-boot-loader/ /app/
# 3. Snapshot dependencies (if any)
COPY --chown=appuser:appgroup target/extracted/snapshot-dependencies/ /app/
# 4. Application code & resources (~1-2MB, changes per commit -> only this layer is pushed/pulled)
COPY --chown=appuser:appgroup target/extracted/application/ /app/

USER appuser

# Default Environment Variables
ENV SERVER_PORT=8080 \
    SPRING_PROFILES_ACTIVE=prod \
    JAVA_OPTS="-XX:+UseG1GC -XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError"

# Default application port
EXPOSE 8080

# Healthcheck using Spring Boot Actuator probe
HEALTHCHECK --interval=10s --timeout=3s --retries=5 --start-period=25s \
  CMD curl -f http://localhost:8080/actuator/health/liveness || exit 1

ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS org.springframework.boot.loader.launch.JarLauncher \"$@\"", "--"]
