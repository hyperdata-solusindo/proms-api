<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
          "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
          "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <module name="TreeWalker">
        <!-- Larang penulisan FQCN internal 'com.hyperdata.proms' inline di luar package dan import -->
        <module name="MatchXpath">
            <property name="query"
                      value="//DOT[IDENT[@text='com'] and IDENT[@text='hyperdata']][not(ancestor::IMPORT)][not(ancestor::PACKAGE_DEF)]"/>
            <message key="matchxpath.match"
                     value="Dilarang menggunakan Fully Qualified Class Name (FQCN) inline. Wajib menggunakan 'import' statement di awal file!"/>
        </module>
    </module>
</module>
