# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Project: hyperdata-solusindo/proms-api-java
#
# Petunjuk Penggunaan:
# 1. Salin file ini menjadi .env:
#    cp .env.example .env
# 2. Sesuaikan nilai variabel di bawah ini dengan konfigurasi lingkungan Anda.
# ==============================================================================

# ==============================================================================
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ==============================================================================

# Host / IP Server PostgreSQL
# - Nilai untuk Local Dev (tanpa Docker): localhost atau 127.0.0.1
# - Nilai untuk Docker Compose: postgres (nama service di docker-compose.yml)
# - Nilai untuk Remote/Staging/Production: misal db.internal.example.com atau IP server
DB_HOST=localhost

# Port PostgreSQL
# - Nilai untuk docker-compose project ini: 5443 (port host yang di-mapping ke 5432 container)
# - Nilai default PostgreSQL standar: 5432
DB_PORT=5443

# Nama Database
# - Default project: app_platform
DB_NAME=app_platform

# Username Database
# - Nilai untuk local docker: platform_user
DB_USER=platform_user

# Password Database
# - Ganti dengan password yang kuat untuk lingkungan production
DB_PASSWORD=platform_password

# Full JDBC URL (Opsional / Override)
# - Kosongkan jika ingin Spring Boot menyusun URL otomatis dari DB_HOST, DB_PORT, dan DB_NAME.
# - Contoh jika diisi manual:
#   DB_URL=jdbc:postgresql://localhost:5443/app_platform?sslmode=disable
DB_URL=


# ==============================================================================
# 2. LIQUIBASE MIGRATION
# ==============================================================================

# Menyalakan / Mematikan migrasi DDL otomatis saat aplikasi dijalankan
# - Pilihan nilai: true | false
# - Nilai untuk Local Dev: false (disarankan matikan jika database sudah termigrasi agar boot cepat)
# - Nilai saat ingin auto-migrate: true
# - Nilai di container 'migration': true (selalu menjalankan migrasi saat deploy)
LIQUIBASE_ENABLED=false

# Filter Context Liquibase (Opsional)
# - Menjalankan changeset yang hanya memiliki context tertentu.
# - Pilihan nilai: dev, staging, prod, test, atau kosongkan
# - Kosongkan untuk menjalankan seluruh changeset standar
LIQUIBASE_CONTEXTS=

# Filter Label Liquibase (Opsional)
# - Menjalankan changeset berdasarkan label spesifik (misal: v1.0, core, reporting)
# - Kosongkan untuk menjalankan semua label
LIQUIBASE_LABELS=


# ==============================================================================
# 3. APPLICATION & SERVER CONFIGURATION
# ==============================================================================

# Port eksternal Host pada Docker Compose
# - Nilai: 8080 (atau ubah ke 8085, 9000 jika port 8080 di laptop Anda sudah dipakai service lain)
APP_PORT=8080

# Port internal web server embedded Tomcat di Spring Boot
# - Default: 8080
SERVER_PORT=8080

# Profil Aktif Spring Boot
# - Mengatur konfigurasi spesifik lingkungan (membaca application-{profile}.properties).
# - Pilihan nilai:
#   * dev   : Lingkungan lokal developer (log lebih detail, swagger aktif)
#   * test  : Lingkungan automated testing / CI-CD
#   * staging: Lingkungan server pengujian internal / UAT
#   * prod  : Lingkungan production live (keamanan ketat, log terkompresi)
SPRING_PROFILES_ACTIVE=dev


# ==============================================================================
# 4. JVM & RUNTIME TUNING (JAVA_OPTS)
# ==============================================================================
# Argumen yang diteruskan langsung ke Java Virtual Machine (JVM) saat proses startup.
#
# Rincian parameter:
# - -Xms<size>              : Alokasi RAM awal (Initial Heap Size).
# - -Xmx<size>              : Batas RAM maksimum yang boleh dipakai (Max Heap Size).
# - -XX:+UseG1GC            : Mengaktifkan Garbage-First (G1) Garbage Collector (efisien & jeda rendah).
# - -Duser.timezone=<zone>  : Standarisasi zona waktu JVM (Asia/Jakarta = WIB, UTC = universal).
# - -XX:+ExitOnOutOfMemoryError : Otomatis terminate jika kehabisan memori agar container restart bersih.
#
# Rekomendasi Nilai Berdasarkan Lingkungan:
# - Local Dev (Hemat RAM di Laptop):
#   JAVA_OPTS="-Xms256m -Xmx512m -XX:+UseG1GC -Duser.timezone=Asia/Jakarta -XX:+ExitOnOutOfMemoryError"
#
# - Server Staging (RAM 2GB - 4GB):
#   JAVA_OPTS="-Xms512m -Xmx1024m -XX:+UseG1GC -Duser.timezone=Asia/Jakarta -XX:+ExitOnOutOfMemoryError"
#
# - Server Production (RAM 4GB - 8GB+):
#   JAVA_OPTS="-Xms1g -Xmx2g -XX:+UseG1GC -Duser.timezone=Asia/Jakarta -XX:+ExitOnOutOfMemoryError -XX:MaxMetaspaceSize=256m"
#
JAVA_OPTS="-Xms256m -Xmx512m -XX:+UseG1GC -Duser.timezone=Asia/Jakarta -XX:+ExitOnOutOfMemoryError"
